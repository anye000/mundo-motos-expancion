# ============================================
# Mundo Motos CRM - Variables de Entorno
# ============================================

# Entorno
NODE_ENV=development
APP_NAME=mundo-motos-crm
VERSION=1.0.0

# ============================================
# SERVIDOR
# ============================================
PORT=3000
HOST=localhost

# CORS
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# ============================================
# FRONTEND (Vite)
# ============================================
VITE_API_BASE_URL=http://localhost:3000/api
VITE_APP_NAME=Mundo Motos CRM
VITE_APP_VERSION=1.0.0

# ============================================
# BASE DE DATOS - Supabase/PostgreSQL
# ============================================

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# PostgreSQL (si usas conexión directa)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mundo_motos_crm
DB_USER=postgres
DB_PASSWORD=your-password-here
DB_SCHEMA=public
DB_SSL=false

# ============================================
# AUTENTICACIÓN
# ============================================

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRATION=30d

# OAuth (Opcional)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# ============================================
# MAPAS Y GEOLOCALIZACIÓN
# ============================================

# OpenStreetMap / Leaflet (No requiere key)
VITE_MAP_PROVIDER=openstreetmap
VITE_MAP_CENTER_LAT=4.7110
VITE_MAP_CENTER_LON=-74.0721
VITE_MAP_ZOOM=10

# Google Maps (Opcional)
VITE_GOOGLE_MAPS_API_KEY=

# Mapbox (Opcional)
VITE_MAPBOX_ACCESS_TOKEN=

# ============================================
# SERVICIOS EXTERNOS
# ============================================

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@mundomotos.com
SMTP_FROM_NAME=Mundo Motos CRM

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Cloud Storage (AWS S3 o Supabase Storage)
STORAGE_TYPE=supabase
STORAGE_BUCKET=uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ============================================
# LOGGING
# ============================================

LOG_LEVEL=info
LOG_FORMAT=json

# ============================================
# SEGURIDAD
# ============================================

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# DESARROLLO
# ============================================

# Debug
DEBUG=false
DEBUG_MODULES=*

# Hot Reload
HOT_RELOAD=true

# ============================================
# PRODUCCIÓN
# ============================================

# CDN
CDN_URL=https://cdn.mundomotos.com

# Sentry (Error tracking)
SENTRY_DSN=

# Google Analytics
VITE_GA_MEASUREMENT_ID=

# Stripe (Pagos)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
